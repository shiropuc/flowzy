+  /**
+   * @brief Process id whose audio (and its children's) must stay out of the stream (Flow).
+   *
+   * Read from the FLOW_AUDIO_EXCLUDE_PID environment variable; 0 means "capture everything".
+   *
+   * @return Process id to exclude, or 0.
+   */
+  // audioclientactivationparams.h is missing from MinGW: same layout as the Windows SDK.
+  constexpr int FLOW_ACTIVATION_TYPE_PROCESS_LOOPBACK = 1;  ///< AUDIOCLIENT_ACTIVATION_TYPE_PROCESS_LOOPBACK
+  constexpr int FLOW_LOOPBACK_MODE_EXCLUDE_TREE = 1;  ///< PROCESS_LOOPBACK_MODE_EXCLUDE_TARGET_PROCESS_TREE
+  constexpr auto FLOW_VAD_PROCESS_LOOPBACK = L"VAD\\Process_Loopback";  ///< VIRTUAL_AUDIO_DEVICE_PROCESS_LOOPBACK
+
+  /**
+   * @brief Mirror of AUDIOCLIENT_ACTIVATION_PARAMS (process loopback variant).
+   */
+  struct flow_activation_params_t {
+    int ActivationType;  ///< Activation type.
+    DWORD TargetProcessId;  ///< Process tree root.
+    int ProcessLoopbackMode;  ///< Include or exclude the tree.
+  };
+
+  DWORD flow_exclude_pid() {
+    char buf[32] {};
+    auto len = GetEnvironmentVariableA("FLOW_AUDIO_EXCLUDE_PID", buf, sizeof(buf));
+    if (len == 0 || len >= sizeof(buf)) {
+      return 0;
+    }
+    return (DWORD) std::strtoul(buf, nullptr, 10);
+  }
